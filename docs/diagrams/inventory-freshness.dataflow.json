      "row": 0,
      "tag": "rate-limited"
    },
    {
      "id": "sdk",
      "type": "backend",
      "label": "SDK collectors",
      "sublabel": "S3·CF·ELBv2·AOSS",
      "stage": 1,
      "row": 2,
      "tag": "denial-safe"
    },
    {
      "id": "sync",
      "type": "backend",
      "label": "sync Lambda",
      "sublabel": "advisory lock",
      "stage": 2,
      "row": 1,
      "tag": "sanitized logs"
    },
    {
      "id": "guard",
      "type": "security",
      "label": "Partial-run guard",
      "sublabel": "skip · stamp",
