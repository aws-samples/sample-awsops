# AWSops v2 web (thin-BFF) 환경변수 예시 / Environment variable reference
#
# 프로덕션 값은 terraform/foundation의 ECS task definition이 주입합니다 — 이 파일은
# 로컬 개발(web/.env.local)용 참조입니다. 실제 값(특히 시크릿)은 절대 커밋하지 마세요.
# (Production values are injected by the ECS task definition; this file documents the
#  variables for local development via web/.env.local. Never commit real values.)
#
# 시크릿은 env가 아니라 SSM/Secrets Manager 경유입니다 (SSM_*_PARAM은 파라미터 "이름"만 담음).

# ── 기본 / Core ──────────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=
PROJECT=awsops-v2
HOST_ACCOUNT_ID=
HOST_ACCOUNT_ALIAS=Host

# ── Aurora (node-pg, IAM 인증) ───────────────────────────────
AURORA_ENDPOINT=
AURORA_DATABASE=awsops
AURORA_USER=

# ── 인증 / Auth (Cognito) ───────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ADMIN_GROUP=
SSM_ADMIN_EMAILS_PARAM=/ops/awsops-v2/admin_emails

# ── AI / AgentCore (source of truth = SSM) ──────────────────
SSM_RUNTIME_ARN_PARAM=/ops/awsops-v2/agentcore/runtime_arn
SSM_INTERPRETER_ID_PARAM=/ops/awsops-v2/agentcore/interpreter_id
ASSISTANT_MODEL_ID=
CLASSIFIER_MODEL_ID=
CLASSIFIER_TIMEOUT_MS=
CODEGEN_MODEL_ID=
SYNTHESIS_MODEL_ID=
MULTI_ROUTE_MIN_SCORE=
MULTI_ROUTE_SYNTHESIS_ENABLED=
HYBRID_ROUTING_ENABLED=
LIVE_ROUTING=
CHAT_TYPEWRITER_MS=

# ── 기능 플래그 / Feature flags (기본 false — terraform 게이트와 lockstep) ──
AI_INSIGHTS_ENABLED=
DATASOURCE_DIAGNOSIS_ENABLED=
DATASOURCE_QUERYGEN_MODEL_ID=
DATASOURCE_SCHEMA_TTL_MS=
INCIDENT_LIFECYCLE_ENABLED=
INTEGRATIONS_WRITE_ENABLED=
INTEGRATIONS_WRITE_SSM=
INTEGRATIONS_SECRET_NAME=
K8SGPT_ENABLED=
K8SGPT_NARRATION_MODEL=
K8SGPT_STALE_MINUTES=
RCA_WRITEBACK_ENABLED=
REMEDIATION_ENABLED=
MUTATING_ACTIONS_SSM=

# ── EKS / 워커 / 알림 ────────────────────────────────────────
ONBOARDED_EKS_CLUSTERS=
EKS_AUTO_REGISTER=
JOBS_QUEUE_URL=
INV_SYNC_FUNCTION=
DIAGNOSIS_SNS_TOPIC_ARN=
AGENT_SPACE_VERSION=

# ── 인시던트 웹훅 시크릿 (SSM 파라미터 이름만) ─────────────────
SSM_INCIDENT_BEARER_PARAM=
SSM_INCIDENT_BEARER_STANDBY_PARAM=
SSM_INCIDENT_HMAC_SECRET_PARAM=
SSM_INCIDENT_HMAC_STANDBY_PARAM=
